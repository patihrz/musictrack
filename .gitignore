## ========================================
## MusicTrack — .gitignore
## ========================================

# Build outputs
bin/
obj/
out/

# Publish output
Publish/
publish/

# Obfuscation
obfuscar.xml
obfuscar_log.xml

# NuGet packages
*.nupkg
*.snupkg
.nuget/
packages/
# Restore NuGet packages lock file (let NuGet manage this)
# project.lock.json  <-- uncomment if you want to ignore it

# Visual Studio files
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.rsuser
*.DotSettings.user

# Visual Studio Code
.vscode/
*.code-workspace

# JetBrains Rider
.idea/
*.sln.iml

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Logs & cache
*.log
logs/
*.cache
*.tmp

# Sensitive / secret files  ← IMPORTANT: NEVER commit these
appsettings.Development.json
appsettings.Local.json
secrets.json
*.pfx
*.p12

# Auto-generated AssemblyInfo (safe to exclude if using SDK-style csproj)
# Properties/AssemblyInfo.cs
