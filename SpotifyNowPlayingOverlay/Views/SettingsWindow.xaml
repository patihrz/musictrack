<Window x:Class="SpotifyNowPlayingOverlay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MusicTrack — Settings" 
        Height="660" 
        Width="520"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        Foreground="White"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <!-- Style for GroupBoxes -->
        <Style TargetType="GroupBox">
            <Setter Property="BorderBrush" Value="#282828"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="Bold" Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" Margin="5,0,5,0" FontSize="14"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Style for Labels -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#AAAAAA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- Style for Slider values -->
        <Style x:Key="SliderValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding AccentBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ TOP HEADER BAR ═══ -->
        <Border Grid.Row="0" Background="#0A0A0A" BorderBrush="#1A1A1A" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- App name + version badge -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="MusicTrack" FontSize="18" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <Border Background="#1DB954" CornerRadius="4" Padding="6,2" Margin="8,0,6,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.1" FontSize="11" FontWeight="Bold" Foreground="Black"/>
                    </Border>
                    <Border Background="#282828" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♫" FontSize="11" Foreground="#1DB954" Margin="0,0,4,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Spotify" FontSize="11" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Nav buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavSettingsBtn" Content="⚙  Settings" Click="NavSettings_Click"
                            Padding="12,6" Margin="0,0,4,0" Cursor="Hand"
                            FontSize="12" FontWeight="SemiBold"
                            Background="{Binding AccentBrush}" Foreground="Black" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="NavAboutBtn" Content="ℹ  About" Click="NavAbout_Click"
                            Padding="12,6" Margin="0,0,4,0" Cursor="Hand"
                            FontSize="12" FontWeight="SemiBold"
                            Background="#282828" Foreground="#AAAAAA" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    <Button x:Name="NavUpdateBtn" Content="⬆  Update" Click="NavUpdate_Click"
                            Padding="12,6" Cursor="Hand"
                            FontSize="12" FontWeight="SemiBold"
                            Background="#282828" Foreground="#AAAAAA" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ SEPARATOR LINE ═══ -->
        <Border Grid.Row="1" Height="1" Background="#222222"/>

        <!-- ═══ PANEL: SETTINGS ═══ -->
        <Grid x:Name="PanelSettings" Grid.Row="2" Margin="16" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,4">
            <StackPanel>
                
                <!-- Spotify Authentication Group -->
                <GroupBox Header="Spotify Account &amp; Auth">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Client ID Input -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Spotify Client ID:" Margin="0,0,8,8"/>
                        <TextBox Grid.Row="0" Grid.Column="1" 
                                 Text="{Binding ClientId, UpdateSourceTrigger=PropertyChanged}" 
                                 Background="#282828" 
                                 Foreground="White" 
                                 BorderBrush="#404040" 
                                 Padding="5" 
                                 Margin="0,0,0,8"
                                 VerticalAlignment="Center"/>

                        <!-- Login Status -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Auth Status:" Margin="0,0,8,8"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="Orange"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                <Setter Property="Foreground" Value="{Binding AccentBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <!-- Show Login when NOT logged in -->
                            <Button Content="Connect Spotify" 
                                    Command="{Binding LoginCommand}" 
                                    Background="{Binding AccentBrush}" 
                                    Foreground="Black" 
                                    FontWeight="Bold"
                                    BorderThickness="0" 
                                    Padding="12,6" 
                                    Cursor="Hand"
                                    Margin="0,0,8,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Show Logout when logged in -->
                            <Button Content="Disconnect" 
                                    Command="{Binding LogoutCommand}" 
                                    Background="#B00020" 
                                    Foreground="White" 
                                    FontWeight="Bold"
                                    BorderThickness="0" 
                                    Padding="12,6" 
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoggedIn}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Overlay Customization Group -->
                <GroupBox Header="Layout &amp; Styling">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Scale -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Overlay Scale:"/>
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="0.5" Maximum="2.0" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding Scale}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Scale, StringFormat={}{0:P0}}" Style="{StaticResource SliderValueStyle}"/>

                        <!-- Opacity -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Background Opacity:"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0.1" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Opacity}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Opacity, StringFormat={}{0:P0}}" Style="{StaticResource SliderValueStyle}"/>

                        <!-- Album Size -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Album Size (px):"/>
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="40" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding AlbumSize}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding AlbumSize}" Style="{StaticResource SliderValueStyle}"/>

                        <!-- Corner Radius -->
                        <Label Grid.Row="3" Grid.Column="0" Content="Corner Radius (px):"/>
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="25" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding CornerRadius}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding CornerRadius}" Style="{StaticResource SliderValueStyle}"/>

                        <!-- Font Size -->
                        <Label Grid.Row="4" Grid.Column="0" Content="Artist Font Size:"/>
                        <Slider Grid.Row="4" Grid.Column="1" Minimum="10" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FontSize}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding FontSize}" Style="{StaticResource SliderValueStyle}"/>

                        <!-- Title Font Size -->
                        <Label Grid.Row="5" Grid.Column="0" Content="Title Font Size:"/>
                        <Slider Grid.Row="5" Grid.Column="1" Minimum="12" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SongTitleFontSize}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding SongTitleFontSize}" Style="{StaticResource SliderValueStyle}"/>

                        <!-- Accent Color -->
                        <Label Grid.Row="6" Grid.Column="0" Content="Accent Color:"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBox Width="80" 
                                     Text="{Binding AccentColor, UpdateSourceTrigger=PropertyChanged}" 
                                     Background="#282828" 
                                     Foreground="White" 
                                     BorderBrush="#404040" 
                                     Padding="3"
                                     VerticalAlignment="Center"/>
                            <Border Width="20" Height="20" Margin="8,0,0,0" BorderBrush="White" BorderThickness="1" VerticalAlignment="Center"
                                    Background="{Binding AccentBrush}"/>

                            <!-- Quick Select Colors -->
                            <Button Content="●" Foreground="#1DB954" FontSize="16" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Spotify Green" Click="QuickColor_Click" Tag="#1DB954" Margin="12,0,0,0"/>
                            <Button Content="●" Foreground="#FF69B4" FontSize="16" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Pink" Click="QuickColor_Click" Tag="#FF69B4"/>
                            <Button Content="●" Foreground="#00FFFF" FontSize="16" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Neon Blue" Click="QuickColor_Click" Tag="#00FFFF"/>
                            <Button Content="●" Foreground="#FFD700" FontSize="16" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Gold" Click="QuickColor_Click" Tag="#FFD700"/>
                            <Button Content="●" Foreground="#FF6347" FontSize="16" Background="Transparent" BorderThickness="0" Cursor="Hand" ToolTip="Tomato Red" Click="QuickColor_Click" Tag="#FF6347"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Behaviors Group -->
                <GroupBox Header="Behavior &amp; Toggles">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Show Overlay -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Show Overlay (Tampilkan Overlay)"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding IsOverlayVisible}" VerticalAlignment="Center" Margin="0,4"/>

                        <!-- Always On Top -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Always on Top (Overlay floating on top)"/>
                        <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" Margin="0,4"/>

                        <!-- Pin to Desktop -->
                        <Label Grid.Row="2" Grid.Column="0" Content="Pin to Desktop (Keep behind all windows)"/>
                        <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding PinToDesktop}" VerticalAlignment="Center" Margin="0,4"/>

                        <!-- Click Through -->
                        <Label Grid.Row="3" Grid.Column="0" Content="Click Through (Clicks pass through overlay)"/>
                        <CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding ClickThrough}" VerticalAlignment="Center" Margin="0,4"/>

                        <!-- Lock Position -->
                        <Label Grid.Row="4" Grid.Column="0" Content="Lock Position (Disable overlay dragging)"/>
                        <CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding LockOverlay}" VerticalAlignment="Center" Margin="0,4"/>

                        <!-- Start with Windows -->
                        <Label Grid.Row="5" Grid.Column="0" Content="Start with Windows (Run on system boot)"/>
                        <CheckBox Grid.Row="5" Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" Margin="0,4"/>

                        <!-- Poll Interval -->
                        <Label Grid.Row="6" Grid.Column="0" Content="Polling Interval (seconds)"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Slider Width="100" Minimum="0.5" Maximum="5.0" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding PollIntervalSeconds}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding PollIntervalSeconds, StringFormat={}{0:F1}s}" Width="35" Foreground="{Binding AccentBrush}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"/>
                        </StackPanel>

                        <!-- Hide when Paused -->
                        <Grid Grid.Row="7" Grid.ColumnSpan="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Label Grid.Row="0" Grid.Column="0" Content="Hide Overlay when paused"/>
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding HideWhenPaused}" VerticalAlignment="Center" Margin="0,4"/>

                            <Label Grid.Row="1" Grid.Column="0" Content="   Hide delay (seconds):" Visibility="{Binding HideWhenPaused, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4" Visibility="{Binding HideWhenPaused, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Slider Width="100" Minimum="1" Maximum="60" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding HideAfterSeconds}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding HideAfterSeconds, StringFormat={}{0:F0}s}" Width="35" Foreground="{Binding AccentBrush}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!-- Lyrics Group -->
                <GroupBox Header="Lyrics (Lirik)">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Show Lyrics Toggle -->
                        <Label Grid.Row="0" Grid.Column="0" Content="Show Synced Lyrics (Tampilkan Lirik Lagu)"/>
                        <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding ShowLyrics}" VerticalAlignment="Center" Margin="0,4"/>

                        <!-- Lyrics Font Size -->
                        <Label Grid.Row="1" Grid.Column="0" Content="Lyrics Font Size (Ukuran Font Lirik):" Visibility="{Binding ShowLyrics, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4" Visibility="{Binding ShowLyrics, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Slider Width="100" Minimum="10" Maximum="24" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LyricsFontSize}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding LyricsFontSize}" Width="35" Foreground="{Binding AccentBrush}" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" TextAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
        </Grid>

        <!-- ═══ PANEL: ABOUT ═══ -->
        <Border x:Name="PanelAbout" Grid.Row="2" Margin="16" Visibility="Collapsed" CornerRadius="8" Background="#181818" BorderBrush="#282828" BorderThickness="1">
            <StackPanel Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">

                <!-- App Icon placeholder -->
                <Border Width="72" Height="72" CornerRadius="16" Background="#1DB954" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="♫" FontSize="36" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- App Name -->
                <TextBlock Text="MusicTrack" FontSize="28" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                <!-- Version -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                    <Border Background="#1DB954" CornerRadius="4" Padding="8,3">
                        <TextBlock Text="Version 1.1.0" FontSize="13" FontWeight="Bold" Foreground="Black"/>
                    </Border>
                </StackPanel>

                <!-- Description -->
                <TextBlock Text="A lightweight, transparent Spotify Now Playing overlay for streamers." 
                           FontSize="13" Foreground="#AAAAAA" HorizontalAlignment="Center" 
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,24" MaxWidth="380"/>

                <!-- Supported Platforms -->
                <TextBlock Text="Supported Platforms" FontSize="12" Foreground="#666666" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <Border Background="#191414" CornerRadius="8" Padding="14,8" BorderBrush="#1DB954" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♫" FontSize="18" Foreground="#1DB954" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Spotify" FontSize="14" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Web API · OAuth PKCE" FontSize="11" Foreground="#888888"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- System Info -->
                <Border Background="#1A1A1A" CornerRadius="6" Padding="16,10" Margin="0,0,0,24">
                    <StackPanel>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Platform" Foreground="#666666" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="Windows 10 / 11" Foreground="#AAAAAA" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Runtime" Foreground="#666666" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text=".NET 8.0 WPF" Foreground="#AAAAAA" FontSize="12"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Build" Foreground="#666666" FontSize="12"/>
                            <TextBlock Grid.Column="1" Text="2026" Foreground="#AAAAAA" FontSize="12"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Made with ♥ for streamers" FontSize="12" Foreground="#444444"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ═══ PANEL: UPDATE ═══ -->
        <Border x:Name="PanelUpdate" Grid.Row="2" Margin="16" Visibility="Collapsed" CornerRadius="8" Background="#181818" BorderBrush="#282828" BorderThickness="1">
            <StackPanel Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">

                <Border Width="60" Height="60" CornerRadius="30" Background="#1A2A1A" HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="⬆" FontSize="28" Foreground="#1DB954" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="Check for Updates" FontSize="22" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>

                <!-- Current version card -->
                <Border Background="#1A1A1A" CornerRadius="8" Padding="20,14" Margin="0,16,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Current Version" Foreground="#666666" FontSize="11"/>
                            <TextBlock Text="MusicTrack v1.1.0" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#1DB95420" CornerRadius="4" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="✓ Latest" Foreground="#1DB954" FontSize="12" FontWeight="Bold"/>
                        </Border>
                    </Grid>
                </Border>

                <TextBlock x:Name="UpdateStatusText"
                           Text="Click the button below to check for the latest version on GitHub."
                           FontSize="13" Foreground="#888888" HorizontalAlignment="Center"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360" Margin="0,0,0,20"/>

                <Button x:Name="CheckUpdateBtn" Content="Check on GitHub" Click="CheckUpdate_Click"
                        Padding="20,10" Cursor="Hand" HorizontalAlignment="Center"
                        FontSize="13" FontWeight="Bold"
                        Background="#1DB954" Foreground="Black" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <TextBlock Text="Opens the GitHub Releases page in your browser." 
                           FontSize="11" Foreground="#444444" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer / Close -->
        <Border Grid.Row="3" Background="#0D0D0D" BorderBrush="#1A1A1A" BorderThickness="0,1,0,0" Padding="16,10">
            <StackPanel x:Name="FooterSettings" Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="Save &amp; Connect" 
                        Click="SaveAndConnect_Click" 
                        Background="{Binding AccentBrush}" 
                        Foreground="Black" 
                        BorderBrush="{Binding AccentBrush}" 
                        Padding="16,8" 
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>
                <Button Content="Save" 
                        Click="Save_Click" 
                        Background="#282828" 
                        Foreground="White" 
                        BorderBrush="#404040" 
                        Padding="16,8" 
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="5"/></Style>
                    </Button.Resources>
                </Button>
                <Button Content="Close" 
                        Click="Close_Click" 
                        Background="#282828" 
                        Foreground="White" 
                        BorderBrush="#404040" 
                        Padding="16,8" 
                        Margin="0,0,10,0"
                        Cursor="Hand"
                        FontWeight="Bold">
                    <Button.Resources>
